{
  "expo": {
    "scheme": "animatchaura",
    "name": "aniMatch",
    "slug": "animatchaura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0E0F13",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.omartrabelsi.animatch",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ato.animatchaura",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F13"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c9ce8209-fd0f-4bf4-b4e7-ed2b7127b841"
      }
    }
  }
}
